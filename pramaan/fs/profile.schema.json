{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pramaan.dev/schema/vendor-profile.schema.json",
  "title": "Pramaan DVR/NVR Vendor Profile",
  "description": "Declarative description of one recorder's on-disk or container byte layout. A field's 'status' distinguishes what is verified from a primary source (confirmed) from what is provisional pending calibration against a real image (unconfirmed) — a profile is never silently claiming more certainty than it has.",
  "type": "object",
  "required": ["vendor", "format_id", "display_name", "version", "confidence", "endian", "signature", "fields"],
  "additionalProperties": false,
  "properties": {
    "vendor": { "type": "string", "minLength": 1 },
    "format_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Stable machine identifier, e.g. 'dahua_dhav_chunk'."
    },
    "display_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "confidence": {
      "type": "string",
      "enum": ["verified", "partial", "provisional"],
      "description": "verified: every field's offset is confirmed from a primary source. partial: signature and some fields confirmed, others unconfirmed pending calibration. provisional: emitted by the unknown-vendor profiler, not yet reviewed."
    },
    "source": { "type": "string", "description": "Citation for where this layout comes from." },
    "license_note": { "type": "string" },
    "endian": { "type": "string", "enum": ["little", "big"] },
    "signature": {
      "type": "object",
      "required": ["offset"],
      "additionalProperties": false,
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "ascii": { "type": "string" },
        "bytes_hex": { "type": "string", "pattern": "^([0-9a-fA-F]{2})+$" },
        "recurring": {
          "type": "boolean",
          "default": false,
          "description": "false: the signature exists exactly once, at 'offset' from the start of the image (e.g. Hikvision's Master Sector). true: the signature recurs throughout the image starting no earlier than 'offset' (e.g. a Dahua DHAV chunk header, repeated once per chunk)."
        },
        "valid_type_bytes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      },
      "oneOf": [
        { "required": ["ascii"] },
        { "required": ["bytes_hex"] }
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    },
    "tail_marker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ascii": { "type": "string" },
        "seek_back_field": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": { "type": "integer", "enum": [1, 2, 4, 8] },
            "dtype": { "type": "string", "enum": ["u8", "u16", "u32", "u64"] },
            "endian": { "type": "string", "enum": ["little", "big"] }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "bitfield": {
      "type": "object",
      "required": ["name", "shift", "bits"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shift": { "type": "integer", "minimum": 0 },
        "bits": { "type": "integer", "minimum": 1, "maximum": 64 },
        "add": { "type": "integer" }
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "offset", "size", "dtype", "status"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "offset": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 1 },
        "dtype": {
          "type": "string",
          "enum": ["u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64", "ascii", "bytes", "bitfields"]
        },
        "endian": {
          "type": "string",
          "enum": ["little", "big"],
          "description": "Overrides the profile-level default endianness for this field only."
        },
        "role": {
          "type": "string",
          "enum": ["channel", "timestamp", "timestamp_packed", "sequence", "length", "pointer", "flag", "identifier"],
          "description": "Semantic meaning, if known. Drives how the value is surfaced in the hex/structure workbench and the timeline."
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "unconfirmed"],
          "description": "confirmed: offset and meaning verified from a primary source. unconfirmed: structurally plausible but not yet verified against a real image of this vendor — the interpreter will still read it, but callers must treat the value as provisional."
        },
        "bitfields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bitfield" }
        },
        "note": { "type": "string" }
      },
      "if": { "properties": { "dtype": { "const": "bitfields" } } },
      "then": { "required": ["bitfields"] }
    }
  }
}
