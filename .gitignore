# ---------------------------------------------------------------------------
# scratch/ is the ONLY place throwaway, exploratory, or debug output belongs.
# It is gitignored in full, unconditionally, so nothing generated there can
# ever be committed by accident.
# ---------------------------------------------------------------------------
/scratch/
/scratch/**

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Virtual environments
.venv/
venv/
env/
ENV/

# Node / web
web/node_modules/
web/dist/
web/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated forensic artifacts — case data, images, and models are never
# committed; they are either user-supplied evidence or downloaded on demand.
*.dd
*.e01
*.E01
*.raw
*.img
/cases/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# Model weights — fetched on first run, never vendored
*.pt
*.onnx
*.pth

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Environment secrets
.env
.env.*
!.env.example
